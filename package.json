{
  "name": "sv-devtools",
  "displayName": "Dev Tool",
  "description": "A lightweight developer toolbox: text diff, regex, JSON, encoding, generators and developer utilities.",
  "version": "0.1.0",
  "publisher": "root-shubh",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/root-Shubh/sv_devtools.git"
  },
  "bugs": {
    "url": "https://github.com/root-Shubh/sv_devtools/issues"
  },
  "homepage": "https://github.com/root-Shubh/sv_devtools#readme",
  "galleryBanner": {
    "color": "#1f6feb",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "developer tools",
    "diff",
    "regex",
    "json",
    "base64",
    "url encode",
    "uuid",
    "hash",
    "jwt",
    "utilities"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devtool",
          "title": "Dev Tool",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "devtool": [
        {
          "id": "devtool.tools",
          "name": "Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "devtool.openTool",
        "title": "Dev Tool: Open Tool"
      },
      {
        "command": "devtool.searchTools",
        "title": "Dev Tool: Search Tools",
        "icon": "$(search)"
      },
      {
        "command": "devtool.toggleFavorite",
        "title": "Dev Tool: Toggle Favorite",
        "icon": "$(star-empty)"
      },
      {
        "command": "devtool.diffSwap",
        "title": "Dev Tool: Swap Diff Sides"
      },
      {
        "command": "devtool.diffClear",
        "title": "Dev Tool: Clear Diff Inputs"
      },
      {
        "command": "devtool.diffSummary",
        "title": "Dev Tool: Diff Summary"
      },
      {
        "command": "devtool.diffCopy",
        "title": "Dev Tool: Copy Differences"
      },
      {
        "command": "devtool.regexReplace",
        "title": "Dev Tool: Regex Replace Preview"
      },
      {
        "command": "devtool.regexCopy",
        "title": "Dev Tool: Copy Regex"
      },
      {
        "command": "devtool.quickClipboard",
        "title": "Dev Tool: Quick Diff - Selection vs Clipboard"
      },
      {
        "command": "devtool.quickTwoSelections",
        "title": "Dev Tool: Quick Diff - Two Selections"
      },
      {
        "command": "devtool.quickFiles",
        "title": "Dev Tool: Quick Diff - Two Files"
      },
      {
        "command": "devtool.jsonFormat",
        "title": "Dev Tool: JSON Format / Minify / Validate"
      },
      {
        "command": "devtool.ctx.base64Encode",
        "title": "Dev Tool: Base64 Encode Selection",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.base64Decode",
        "title": "Dev Tool: Base64 Decode Selection",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.formatJson",
        "title": "Dev Tool: Format JSON Selection",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.dedupeLines",
        "title": "Dev Tool: Remove Duplicate Lines",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.sha256",
        "title": "Dev Tool: SHA-256 Selection",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.compareWithClipboard",
        "title": "Dev Tool: Compare Selection with Clipboard",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.ctx.openRegex",
        "title": "Dev Tool: Open Selection in Regex Playground",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.showTools",
        "title": "Dev Tool: Show Tools View",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.refreshTools",
        "title": "Dev Tool: Refresh Tools View",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.clearState",
        "title": "Dev Tool: Clear Favourites and Recently Used",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.reloadWindow",
        "title": "Dev Tool: Reload Window (restart extensions)",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.version",
        "title": "Dev Tool: Show Version",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.file.sha256",
        "title": "Dev Tool: SHA-256 of File",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.file.base64",
        "title": "Dev Tool: Base64 of File",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.file.stats",
        "title": "Dev Tool: Line, Word and Character Count",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.file.jsonValidate",
        "title": "Dev Tool: Validate JSON File",
        "category": "Dev Tool"
      },
      {
        "command": "devtool.file.jsonFormat",
        "title": "Dev Tool: Format JSON File",
        "category": "Dev Tool"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devtool.searchTools",
          "when": "view == devtool.tools",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devtool.toggleFavorite",
          "when": "view == devtool.tools && viewItem =~ /devtool.tool/",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "devtool.ctx.base64Encode",
          "when": "editorHasSelection",
          "group": "9_devtool@1"
        },
        {
          "command": "devtool.ctx.base64Decode",
          "when": "editorHasSelection",
          "group": "9_devtool@2"
        },
        {
          "command": "devtool.ctx.formatJson",
          "when": "editorHasSelection",
          "group": "9_devtool@3"
        },
        {
          "command": "devtool.ctx.dedupeLines",
          "when": "editorHasSelection",
          "group": "9_devtool@4"
        },
        {
          "command": "devtool.ctx.sha256",
          "when": "editorHasSelection",
          "group": "9_devtool@5"
        },
        {
          "command": "devtool.ctx.compareWithClipboard",
          "when": "editorHasSelection",
          "group": "9_devtool@6"
        },
        {
          "command": "devtool.ctx.openRegex",
          "when": "editorHasSelection",
          "group": "9_devtool@7"
        }
      ],
      "commandPalette": [
        {
          "command": "devtool.openTool",
          "when": "false"
        },
        {
          "command": "devtool.toggleFavorite",
          "when": "false"
        },
        {
          "command": "devtool.file.sha256",
          "when": "false"
        },
        {
          "command": "devtool.file.base64",
          "when": "false"
        },
        {
          "command": "devtool.file.stats",
          "when": "false"
        },
        {
          "command": "devtool.file.jsonValidate",
          "when": "false"
        },
        {
          "command": "devtool.file.jsonFormat",
          "when": "false"
        }
      ],
      "explorer": [
        {
          "submenu": "devtool.explorer",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "9_devtool"
        }
      ],
      "devtool.explorer": [
        {
          "command": "devtool.file.sha256",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_devtool@1"
        },
        {
          "command": "devtool.file.base64",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_devtool@2"
        },
        {
          "command": "devtool.file.stats",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_devtool@3"
        },
        {
          "command": "devtool.file.jsonValidate",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json",
          "group": "1_devtool@4"
        },
        {
          "command": "devtool.file.jsonFormat",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json",
          "group": "1_devtool@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devtool.searchTools",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "true"
      },
      {
        "command": "devtool.openTool",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "args": "regex-playground",
        "when": "true"
      },
      {
        "command": "devtool.openTool",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "args": "json-format",
        "when": "true"
      },
      {
        "command": "devtool.openTool",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "args": "text-diff",
        "when": "true"
      }
    ],
    "viewsWelcome": [
      {
        "view": "devtool.tools",
        "contents": "Dev Tool is a toolbox for everyday developer tasks: diff, regex, JSON, encoding, generators and references.\n[Search tools](command:devtool.searchTools)\nSelect text in any editor and right-click to use Dev Tool actions on it."
      }
    ],
    "submenus": [
      {
        "id": "devtool.explorer",
        "label": "Dev Tool"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "3.9.1"
  }
}
